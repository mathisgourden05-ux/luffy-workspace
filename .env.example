# ============================================================
#  .env.example — TEMPLATE PUBLIC
# ============================================================
#  Liste des variables attendues, SANS valeurs.
#  Ce fichier PEUT être partagé / committé : il ne contient aucun secret.
#
#  Utilisation : copie-le en « .env » puis remplis les valeurs.
#    PowerShell : Copy-Item .env.example .env
# ============================================================

# --- IA ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# --- Productivité / Notion ---
NOTION_API_KEY=

# --- Google ---
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube ---
YOUTUBE_API_KEY=

# --- Hébergement / Déploiement ---
VERCEL_TOKEN=

# --- Code / GitHub ---
GITHUB_TOKEN=

# --- Paiement / Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
